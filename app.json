{
  "expo": {
    "name": "Aube",
    "slug": "smart_clock",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "smartclock",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e1a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.poirouxmartin.smartclock",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Aube a besoin d'accéder au microphone pour analyser votre sommeil via les sons nocturnes.",
        "UIBackgroundModes": [
          "audio",
          "background-processing"
        ]
      },
      "associatedDomains": [
        "applinks:smartclock.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0e1a",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png"
      },
      "package": "com.poirouxmartin.smartclock",
      "versionCode": 5,
      "permissions": [
        "FOREGROUND_SERVICE",
        "WAKE_LOCK",
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "smartclock"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-notifications",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "kotlinVersion": "2.1.20",
            "enableProguardInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-localization",
      "expo-sqlite"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "eas": {
        "projectId": "smart_clock"
      }
    },
    "owner": "poirouxmartin"
  }
}
